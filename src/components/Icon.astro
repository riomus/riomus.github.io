      <path d="M10.5 2a8.5 8.5 0 1 0 5.2 15.2l4.6 4.6 1.9-1.9-4.6-4.6A8.5 8.5 0 0 0 10.5 2Zm0 2.6a5.9 5.9 0 1 1 0 11.8 5.9 5.9 0 0 1 0-11.8Z" />
    </svg>
  )
}
{
  name === 'arrow' && (
    <svg class={k} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M11.3 3.5 12.9 5 7.9 10h12.6v2.2H7.9l5 5-1.6 1.5-7.6-7.6 7.6-7.6Z" />
    </svg>
  )
}
{
  name === 'check' && (
    <svg class={k} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M20 6 9 17l-5-5" />
    </svg>
  )
}
{
  name === 'ext' && (
    <svg class={k} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
