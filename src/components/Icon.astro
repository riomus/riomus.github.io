---
/** One stroke system for every mark. Brand marks keep their own official
 * geometry; the rest are drawn to match their weight.
 *
 * Every icon carries the global `.icon` class, which sizes it to 1em. Page
 * styles are scoped to their own template and cannot reach this SVG, so any
 * override has to come from global.css or from the parent's font-size. */
interface Props {
  name: 'linkedin' | 'github' | 'rss' | 'key' | 'search' | 'arrow' | 'check' | 'ext' | 'mail';
  class?: string;
}
const { name, class: cls = '' } = Astro.props;
const k = ['icon', name === 'github' && 'icon--dense', cls].filter(Boolean).join(' ');
---

{
  name === 'linkedin' && (
    <svg class={k} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM2.4 21h5.16V9.5H2.4V21Zm7.74-11.5V21h5.16v-6.2c0-1.63.31-3.21 2.33-3.21 1.99 0 2.02 1.86 2.02 3.31V21h5.16v-7.13c0-4.48-.97-7.03-5.2-7.03-2.03 0-3.4 1.12-3.96 2.18h-.07V9.5h-5.44Z" />
    </svg>
  )
}
{
  name === 'github' && (
    <svg class={k} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.2 11.39.6.11.82-.26.82-.58l-.01-2.05c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.34-5.47-5.96 0-1.32.47-2.39 1.24-3.23-.12-.31-.54-1.53.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6.01 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.65.24 2.87.12 3.18.77.84 1.24 1.91 1.24 3.23 0 4.63-2.81 5.65-5.49 5.95.43.37.82 1.1.82 2.22l-.01 3.29c0 .32.21.7.82.58A12.01 12.01 0 0 0 24 12.5C24 5.87 18.63.5 12 .5Z" />
    </svg>
  )
}
{
  name === 'rss' && (
    <svg class={k} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <circle cx="5.4" cy="18.6" r="2.6" />
      <path d="M3 10.3v3.1c4.2 0 7.6 3.4 7.6 7.6h3.1c0-5.9-4.8-10.7-10.7-10.7z" />
      <path d="M3 4v3.1c7.7 0 13.9 6.2 13.9 13.9H20C20 11.6 12.4 4 3 4z" />
    </svg>
  )
}
{
  name === 'key' && (
    <svg class={k} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M15.2 2.5a6.6 6.6 0 0 0-6.3 8.6l-6.4 6.4a1 1 0 0 0-.3.7v3.1a.7.7 0 0 0 .7.7h3.2a.7.7 0 0 0 .7-.7v-1.6h1.6a.7.7 0 0 0 .7-.7v-1.6h1.6a.7.7 0 0 0 .5-.2l1.5-1.5a6.6 6.6 0 1 0 2.5-13.2zm2.1 5.5a1.9 1.9 0 1 1 0-3.8 1.9 1.9 0 0 1 0 3.8z" />
