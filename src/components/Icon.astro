---
/** Icons come from maintained sets, inlined at build time by astro-icon —
 * no runtime fetch, no sprite, no network.
 *
 * Brand marks are Simple Icons, which ships the official vendor paths, so
 * GitHub's and LinkedIn's marks are theirs rather than an approximation.
 * Everything else is Phosphor, using the Fill weight where an icon sits
 * beside a brand mark (the footer) and the regular weight for UI, so a row
 * never mixes solid and stroked drawings.
 *
 * Sizing lives on the global `.icon` class: a page's scoped styles cannot
 * reach an SVG rendered inside this component. */
import { Icon as Iconify } from 'astro-icon/components';

interface Props {
  name: 'linkedin' | 'github' | 'rss' | 'key' | 'search' | 'arrow' | 'check' | 'ext' | 'mail';
  class?: string;
}

const SET = {
  github: 'simple-icons:github',
  linkedin: 'simple-icons:linkedin',
  rss: 'simple-icons:rss',
  mail: 'ph:envelope-simple-fill',
  key: 'ph:key-fill',
  arrow: 'ph:arrow-left-bold',
  ext: 'ph:arrow-square-out-bold',
  check: 'ph:check-bold',
  search: 'ph:magnifying-glass-bold',
} as const;

const { name, class: cls = '' } = Astro.props;
const k = ['icon', cls].filter(Boolean).join(' ');
---

<Iconify name={SET[name]} class={k} aria-hidden="true" />
