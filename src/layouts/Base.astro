---
import '../styles/global.css';
import Icon from '../components/Icon.astro';

interface Props {
  title?: string;
  description?: string;
  ogType?: string;
}

const SITE = 'Roman Bartusiak';
const {
  title,
  description = 'Roman Bartusiak — AI researcher, ML and distributed systems engineer in Wrocław. Agentic AI, NLP, high-throughput distributed backends, and measured work on DGX Spark and PyTorch.',
  ogType = 'website',
} = Astro.props;

const pageTitle = title ? `${title} — ${SITE}` : `${SITE} — AI researcher and ML engineer`;
const path = Astro.url.pathname;
const here = (p: string) => (p === '/' ? path === '/' : path.startsWith(p));
const canonical = new URL(path, Astro.site ?? 'https://bartusiak.ai').href;
const year = new Date().getFullYear();

const nav = [
  { href: '/writing/', label: 'Writing' },
  { href: '/about/', label: 'About' },
  { href: '/software/', label: 'Software' },
  { href: '/didactics/', label: 'Teaching' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/assets/img/favicon-192.png" />
    <link rel="apple-touch-icon" href="/assets/img/favicon-180.png" />
    <link rel="alternate" type="application/rss+xml" title={SITE} href="/rss.xml" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE} />
    <meta name="twitter:card" content="summary_large_image" />
    {
      Astro.url.pathname === '/' && (
        <link rel="preload" as="image" href="/assets/img/roman-640.webp" imagesrcset="/assets/img/roman-320.webp 320w, /assets/img/roman-640.webp 640w" imagesizes="(max-width: 820px) 160px, 320px" type="image/webp" fetchpriority="high" />
      )
    }
    {/* Both faces are preloaded so neither waits on CSS parsing to be
        discovered. Chivo is not used above the fold, but it is on every page
        and is 9.6KB — cheaper to fetch in parallel than to chain. */}
    <link rel="preload" href="/fonts/archivo-subset.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/chivo-subset.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      /* Set before first paint: the reveal states only apply when JS can
         un-apply them, so a JS-off load renders the finished page. */
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js');
      }
    </script>
    <slot name="head" />
  </head>
  <body>
    <!--
      Built by hand. Astro, no framework, no tracker, no cookie banner.
      Archivo and Chivo Mono, self-hosted. The green is from the RBR#720 mark.
      Source: https://github.com/riomus/riomus.github.io
    -->
    <a class="skip" href="#main">Skip to content</a>
    <span id="top-sentinel" aria-hidden="true"></span>

    <header class="hdr">
      <div class="wrap hdr__in">
        <a class="hdr__me" href="/">
          <img
            class="hdr__mark"
            src="/assets/img/mark-64.png"
            alt=""
            width="26"
            height="26"
            aria-hidden="true"
          />
          <span class="hdr__name">Roman Bartusiak</span>
        </a>

        <nav class="hdr__nav" aria-label="Primary">
          {
            nav.map((n) => (
              <a class="hdr__link" href={n.href} aria-current={here(n.href) ? 'page' : undefined}>
                {n.label}
              </a>
            ))
          }

        </nav>

        <a class="btn btn--sm hdr__cta" data-mail href="/about/">Contact me</a>
      </div>
      <span class="progress" aria-hidden="true"></span>
    </header>

    <main id="main">
      <slot />
    </main>

    <script>
      /* The header takes its elevation only when something has scrolled
         under it. IntersectionObserver, so nothing runs per frame. */
      const sentinel = document.getElementById('top-sentinel');
      const hdr = document.querySelector('.hdr');
      if (sentinel && hdr) {
        new IntersectionObserver(
          ([e]) => hdr.toggleAttribute('data-scrolled', !e.isIntersecting),
          { rootMargin: '0px' }
        ).observe(sentinel);
      }

      const calm = matchMedia('(prefers-reduced-motion: reduce)');

      /* Reading progress is an orientation aid, not decoration — it runs
         regardless of the motion preference. */
      const bar = document.querySelector('.progress');
      if (bar) {
        let queued = false;
        const draw = () => {
          queued = false;
          const max = document.documentElement.scrollHeight - innerHeight;
          bar.style.setProperty('--p', max > 0 ? String(Math.min(scrollY / max, 1)) : '0');
        };
        addEventListener(
          'scroll',
          () => {
            if (queued) return;
            queued = true;
            requestAnimationFrame(draw);
          },
          { passive: true }
        );
        addEventListener('resize', draw, { passive: true });
        draw();
      }

      /* Reveal on entry, once per element, then stop observing it. */
      if (!calm.matches) {
        const targets = document.querySelectorAll('[data-reveal], [data-stagger]');
        const io = new IntersectionObserver(
          (entries, obs) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              e.target.classList.add('is-in');
              obs.unobserve(e.target);
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.08 }
        );
        for (const t of targets) io.observe(t);
      }

      /* Assembled at runtime so the address never sits in the HTML source. */
      const addr = atob('cm9tYW5AYmFydHVzaWFrLmFp');
      for (const el of document.querySelectorAll('[data-mail]')) {
        el.setAttribute('href', 'mail' + 'to:' + addr);
        if (el.hasAttribute('data-mail-text')) el.textContent = addr;
      }
    </script>

    <footer class="ftr">
      <div class="wrap ftr__in">
        <div>
          <p class="ftr__id">
            <img
              class="ftr__mark"
              src="/assets/img/mark-64.png"
              alt="RBR#720"
              width="22"
              height="22"
            />
            <span>Roman Bartusiak</span>
          </p>
          <p class="ftr__sign">
            AI researcher, ML and distributed systems engineer in Wrocław, Poland. Writing up what
            the hardware actually does.
          </p>
          <p class="ftr__sign ftr__colophon">
            Set in Archivo and Chivo Mono, self-hosted. Built with Astro, hosted on GitHub Pages —
            no trackers, no cookies, no comment section. The green is the RBR#720 mark's own.
          </p>
          <p class="ftr__sign">© {year} · <a href="https://github.com/riomus/riomus.github.io" rel="noopener">Source on GitHub</a></p>
        </div>

        <nav class="ftr__cols" aria-label="Footer">
          <div class="ftr__col">
            <p class="ftr__ch">Site</p>
            <a href="/writing/">Writing</a>
            <a href="/about/">About</a>
            <a href="/software/">Software</a>
            <a href="/didactics/">Teaching</a>
          </div>
          <div class="ftr__col">
            <p class="ftr__ch">Elsewhere</p>
            <a data-mail href="/about/"><Icon name="mail" class="icon--ghost" />Email</a>
            <a href="https://github.com/riomus" rel="me noopener">
              <Icon name="github" class="icon--ghost" />GitHub
            </a>
            <a href="https://www.linkedin.com/in/romanbartusiak/" rel="me noopener">
              <Icon name="linkedin" class="icon--ghost" />LinkedIn
            </a>
            <a href="/rss.xml"><Icon name="rss" class="icon--ghost" />RSS</a>
            <a href="/pubring.asc"><Icon name="key" class="icon--ghost" />PGP key</a>
          </div>
        </nav>
      </div>
    </footer>
  </body>
</html>

<style>
  /* Keep the wordmark at every width — the nav wraps to its own row
     instead, so nothing has to be sacrificed for it. */
  .hdr__name {
    white-space: nowrap;
  }
</style>
