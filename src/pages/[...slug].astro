---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { postHref, tagSlug, readingTime } from '../utils';
import { profile } from '../data/record';

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).sort(
    (a, b) => a.data.date.valueOf() - b.data.date.valueOf()
  );
  return posts.map((post, i) => {
    const iso = post.data.date.toISOString().slice(0, 10);
    const name = post.id.replace(/^\d{4}-\d{2}-\d{2}-/, '');
    return {
      params: { slug: `${iso.slice(0, 4)}/${iso.slice(5, 7)}/${iso.slice(8, 10)}/${name}` },
      props: { post, prev: posts[i - 1] ?? null, next: posts[i + 1] ?? null },
    };
  });
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h: any) => h.depth === 2 || h.depth === 3);
const d = post.data.date;
const stamp = d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const specs = [
  post.data.rig && { k: 'Rig', v: post.data.rig },
  post.data.stack && { k: 'Stack', v: post.data.stack },
  post.data.finding && { k: 'Finding', v: post.data.finding, hot: true },
].filter(Boolean) as { k: string; v: string; hot?: boolean }[];
---

<Base title={post.data.title} description={post.data.description} ogType="article">
  <article class="wrap">
    <header class="ahead">
      <p class="ahead__meta">
        <time datetime={d.toISOString().slice(0, 10)}>{stamp}</time>
      </p>
      <h1 class="display ahead__t">{post.data.title}</h1>
      <p class="lede ahead__d">{post.data.description}</p>

      {
        specs.length > 0 && (
          <div class="strip ahead__strip">
            {specs.map((s) => (
              <div class="strip__cell">
                <span class="strip__k">{s.k}</span>
                <span class:list={['strip__v', s.hot && 'strip__v--accent']}>{s.v}</span>
              </div>
            ))}
          </div>
        )
      }

      <p class="ahead__tags">
        {
          post.data.tags.map((t: string) => (
            <a class="chip" href={`/tags/${tagSlug(t)}/`}>
              {t}
            </a>
          ))
        }
      </p>
    </header>

    <div class="article">
      <div class="prose abody"><Content /></div>

      {
        toc.length > 2 && (
          <aside class="toc" aria-labelledby="toc-h">
            <p class="toc__h" id="toc-h">On this page</p>
            <nav>
              <ul class="toc__list">
                {toc.map((h: any) => (
                  <li>
                    <a
                      class:list={['toc__l', h.depth === 3 && 'toc__l--sub']}
                      href={`#${h.slug}`}
                      data-toc={h.slug}
                    >
                      {h.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
            {post.data.finding && (
              <p class="toc__find">
                <span class="toc__fk">Finding</span>
                {post.data.finding}
              </p>
            )}
          </aside>
        )
      }
    </div>

    {/* Most sessions start on a post, so the post has to say who measured
        this and offer a way to reply. It used to just stop. */}
    <aside class="sig">
      <img class="sig__face" src="/assets/img/roman-320.jpg" alt="" width="56" height="56" />
      <div>
        <p class="sig__t">
          Measured and written by <b>Roman Bartusiak</b> — {profile.title} in {profile.location}.
        </p>
        <p class="sig__l">
          <a data-mail href="/about/"><Icon name="mail-ui" class="" />Email me about this post</a>
          <a href="/rss.xml"><Icon name="rss" class="" />Subscribe</a>
          <a href="https://github.com/riomus" rel="me noopener">
            <Icon name="github" class="" />GitHub
          </a>
        </p>
      </div>
    </aside>

    <nav class="adj" aria-label="More posts" data-stagger>
      {
        prev ? (
          <a class="adj__l" href={postHref(prev)}>
            <span class="adj__k">
              <Icon name="arrow" class="" /> Older
            </span>
            <span class="adj__t">{prev.data.title}</span>
          </a>
        ) : (
          <a class="adj__l" href="/writing/">
            <span class="adj__k">
              <Icon name="arrow" class="" /> Index
            </span>
            <span class="adj__t">Every post</span>
          </a>
        )
      }
      {
        next ? (
          <a class="adj__l adj__l--r" href={postHref(next)}>
            <span class="adj__k">Newer</span>
            <span class="adj__t">{next.data.title}</span>
          </a>
        ) : (
          <a class="adj__l adj__l--r" href="/writing/">
            <span class="adj__k">Index</span>
            <span class="adj__t">Every post</span>
          </a>
        )
      }
    </nav>
  </article>
</Base>

<script>
  const calm = matchMedia('(prefers-reduced-motion: reduce)');

  /* Rail follows the reader. */
  const links = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>('[data-toc]').forEach((a) => links.set(a.dataset.toc!, a));
  if (links.size) {
    const seen = new Set<string>();
    const mark = () => {
      let active: string | undefined;
      for (const id of links.keys()) if (seen.has(id)) active = active ?? id;
      for (const [id, el] of links) el.toggleAttribute('data-active', id === active);
    };
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const id = (e.target as HTMLElement).id;
          if (e.isIntersecting) seen.add(id);
          else seen.delete(id);
        }
        // topmost visible heading wins
        const order = [...links.keys()];
        const first = order.find((id) => seen.has(id));
        for (const [id, el] of links) el.toggleAttribute('data-active', id === first);
      },
      { rootMargin: '-88px 0px -70% 0px', threshold: 0 }
    );
    for (const id of links.keys()) {
      const h = document.getElementById(id);
      if (h) io.observe(h);
    }
    mark();
  }

  /* A heading with an id deserves something to click. */
  for (const h of document.querySelectorAll<HTMLElement>('.prose h2[id], .prose h3[id]')) {
    const a = document.createElement('a');
    a.className = 'anchor';
    a.href = `#${h.id}`;
    a.textContent = '#';
    a.setAttribute('aria-label', `Link to section: ${h.textContent}`);
    h.appendChild(a);
  }

  /* Copy on code blocks. Added by script, so it never ships to a reader
     without JS and never appears in the page source as dead chrome. */
  for (const pre of document.querySelectorAll<HTMLElement>('.prose pre')) {
    const wrap = document.createElement('div');
    wrap.className = 'codewrap';
    pre.parentNode?.insertBefore(wrap, pre);
    wrap.appendChild(pre);

    const lang = pre.getAttribute('data-language');
    if (lang && lang !== 'plaintext') {
      const tag = document.createElement('span');
      tag.className = 'codelang';
      tag.textContent = lang;
      wrap.appendChild(tag);
    }

    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'copy';
    btn.textContent = 'Copy';
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.innerText);
        btn.textContent = 'Copied';
        btn.setAttribute('data-ok', '');
      } catch {
        btn.textContent = 'Press \u2318C';
      }
      setTimeout(() => {
        btn.textContent = 'Copy';
        btn.removeAttribute('data-ok');
      }, 1600);
    });
    wrap.appendChild(btn);
  }
</script>

<style>
  .ahead {
    max-width: var(--prose);
    margin-inline: auto;
    padding-block: clamp(2.5rem, 6vw, 4rem) 0;
  }
  .ahead__meta {
    margin: 0 0 1rem;
    font-size: var(--t-base);
    color: var(--muted);
  }
  .ahead__t {
    font-size: var(--d-md);
  }
  .ahead__d {
    margin: 1.1rem 0 0;
  }
  .ahead__strip {
    margin-top: 1.75rem;
  }
  .ahead__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 1.25rem 0 0;
  }
  .article {
    padding-block: 0;
  }
  .abody {
    max-width: var(--prose);
    margin-inline: auto;
    padding-block: clamp(2.25rem, 5vw, 3.25rem) clamp(3rem, 7vw, 4.5rem);
    border-bottom: 1px solid var(--line);
  }
  /* The rail is the docs device this page was missing: where you are, what
     the run found, and a way back into the piece. It only appears when there
     is room for it and enough sections to be worth one. */
  .toc {
    display: none;
  }
  @media (min-width: 1200px) {
    .article {
      display: grid;
      grid-template-columns: minmax(0, var(--prose)) 14rem;
      gap: 3.5rem;
      justify-content: center;
      align-items: start;
    }
    .abody {
      margin-inline: 0;
    }
    .toc {
      display: block;
      position: sticky;
      top: 5.5rem;
      padding-block: clamp(2.25rem, 5vw, 3.25rem) 0;
    }
    /* With the rail beside it, a plate breaking the measure runs under the
       sticky rail. Keep it in the column. */
    .article:has(.toc) :global(.plate) {
      width: auto;
      margin-inline: 0;
    }
  }
  .toc__h {
    margin: 0 0 0.75rem;
    font-size: var(--t-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .toc__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--line);
  }
  .toc__l {
    display: block;
    padding: 0.32rem 0 0.32rem 0.85rem;
    margin-left: -1px;
    border-left: 1px solid transparent;
    font-size: var(--t-base);
    line-height: 1.4;
    color: var(--muted);
    text-decoration: none;
    transition: color 160ms var(--ease), border-color 160ms var(--ease);
  }
  .toc__l:hover {
    color: var(--ink);
  }
  .toc__l--sub {
    padding-left: 1.6rem;
    font-size: var(--t-sm);
  }
  .toc__l[data-active] {
    color: var(--accent);
    border-left-color: var(--accent);
    font-weight: 600;
  }
  .toc__find {
    margin: 1.5rem 0 0;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
    font-family: 'Chivo Mono', monospace;
    font-size: var(--t-xs);
    line-height: 1.55;
    color: var(--ink);
  }
  .toc__fk {
    display: block;
    margin-bottom: 0.3rem;
    font-family: 'Archivo', sans-serif;
    font-size: var(--t-2xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .sig {
    display: flex;
    gap: 1.15rem;
    align-items: flex-start;
    max-width: var(--prose);
    margin-inline: auto;
    padding: 1.6rem 0 0;
  }
  .sig__face {
    flex: none;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 0 0 1px var(--line);
  }
  .sig__t {
    margin: 0;
    font-size: var(--t-md);
    line-height: 1.55;
    color: var(--body);
  }
  .sig__t b {
    font-weight: 650;
    color: var(--ink);
  }
  .sig__l {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    margin: 0.6rem 0 0;
  }
  .sig__l a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--t-base);
    color: var(--accent);
    text-decoration: none;
  }
  .sig__l a:hover {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .adj {
    max-width: var(--prose);
    margin-inline: auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1rem;
    padding-block: 2rem clamp(3.5rem, 8vw, 6rem);
  }
  .adj__l {
    display: grid;
    gap: 0.35rem;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    text-decoration: none;
    transition: border-color 150ms var(--ease), background-color 150ms var(--ease);
  }
  .adj__l:hover {
    border-color: var(--line-strong);
    background: var(--surface);
  }
  .adj__l--r {
    text-align: right;
  }
  .adj__k {
    font-size: var(--t-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .adj__t {
    font-size: var(--t-root);
    font-weight: 650;
    letter-spacing: -0.018em;
    line-height: 1.3;
    color: var(--ink);
  }
  .adj__l:hover .adj__t {
    color: var(--accent);
  }
</style>
