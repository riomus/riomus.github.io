---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostRow from '../components/PostRow.astro';
import ToptalBadge from '../components/ToptalBadge.astro';
import Icon from '../components/Icon.astro';
import { profile, publications, software, experience, grants } from '../data/record';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const recent = posts.slice(0, 4);
const current = experience.filter((e) => e.to === 'Present');
/** Newest first, so the home page shows the work that dates best. */
const featured = [...publications].sort((a, b) => Number(b.year) - Number(a.year));
const shownSoftware = software;
---

<Base>
  {/* ── Hero ─────────────────────────────────────────────────────────── */}
  <section class="wrap hero">
    <div class="hero__text settle">
      <h1 class="display">Roman&nbsp;Bartusiak</h1>
      <p class="hero__role">{profile.title} · Wrocław, Poland</p>
      <p class="lede hero__lede">
        I build production AI and ML systems — agentic platforms, NLP, semantic search and the
        distributed backends underneath them — and <span class="hl">I publish the measurements</span>.
      </p>
      <p class="hero__actions">
        <a class="btn btn--accent" data-mail href="/about/">
          <Icon name="mail" class="" />Contact me
        </a>
        <a class="btn btn--ghost" href="/about/">Read the full record</a>
      </p>
      <p class="hero__now">
        Now: <b>Founder / Researcher</b> at Causality · Roosters, and freelance through <b>Toptal</b>.
      </p>
      <p class="hero__cred">
        <b>{profile.yearsSoftware}+ years</b> writing software, <b>{profile.yearsAI}+</b> of them in
        AI and machine learning. <b>{publications.length}</b> peer-reviewed papers and{' '}
        <b>{grants.count}</b> research and R&amp;D projects.
      </p>
    </div>

    <figure class="hero__fig">
      <picture>
        <source
          type="image/webp"
          sizes="(max-width: 820px) 160px, 320px"
          srcset="/assets/img/roman-320.webp 320w, /assets/img/roman-640.webp 640w"
        />
        <img
          src="/assets/img/roman-640.jpg"
          srcset="/assets/img/roman-320.jpg 320w, /assets/img/roman-640.jpg 640w"
          sizes="(max-width: 820px) 160px, 320px"
          alt="Roman Bartusiak"
          width="640"
          height="640"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    </figure>
  </section>

  {/* ── Writing ──────────────────────────────────────────────────────── */}
  <section class="section section--line">
    <div class="wrap">
      <div class="section__head" data-reveal="up">
        <div>
          <h2 class="section__h">Writing</h2>
          <p class="section__sub">
            Measured work, mostly on hardware and runtimes other people are guessing about.
          </p>
        </div>
      </div>
      <ul class="rows" data-stagger>
        {recent.map((p) => <PostRow post={p} showTags />)}
      </ul>
      <p class="more"><a class="more__l" href="/writing/">Filter and search every post →</a></p>
    </div>
  </section>

  {/* ── Research: titles, not just numbers ───────────────────────────── */}
  <section class="section section--line">
    <div class="wrap">
      <div class="section__head" data-reveal="up">
        <div>
          <h2 class="section__h">Research</h2>
          <p class="section__sub">
            {publications.length} publications across NLP, graph and network science, distributed data
            processing and representation learning.
          </p>
        </div>
      </div>
      <ul class="rows" data-stagger>
        {
          featured.map((p) => (
            <li class="row">
              <a class="row__link" href={p.href} rel="noopener">
                <span class="row__date mono">{p.year}</span>
                <div>
                  <h3 class="row__t">{p.title}</h3>
                  <p class="row__d">{p.venue}</p>
                  <p class="row__auth">{p.authors}</p>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ── Software ─────────────────────────────────────────────────────── */}
  <section class="section section--surface">
    <div class="wrap">
      <div class="section__head" data-reveal="up">
        <div>
          <h2 class="section__h">Open source</h2>
          <p class="section__sub">Libraries I wrote and still stand behind.</p>
        </div>
      </div>
      <ul class="rows rows--tight" data-stagger>
        {
          shownSoftware.map((s) => (
            <li class="row">
              {s.href ? (
                <a class="row__link row__link--tight" href={s.href} rel="noopener">
                  <span class="row__date mono">{s.name}</span>
                  <div>
                    <p class="row__d">{s.note}</p>
                  </div>
                </a>
              ) : (
                <div class="row__link row__link--tight row__link--plain">
                  <span class="row__date mono">{s.name}</span>
                  <div>
                    <p class="row__d">{s.note}</p>
                  </div>
                </div>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ── Contact ──────────────────────────────────────────────────────── */}
  <section class="section section--line">
    <div class="wrap contact" data-reveal="up">
      <div>
        <h2 class="contact__h">Open to interesting work</h2>
        <p class="lede contact__p">
          Top-3% of the Toptal network since 2018. AI platforms, ML engineering, distributed
          backends, and the unglamorous performance work in between.
        </p>
        <p class="contact__actions">
          <a class="btn btn--accent" data-mail href="/about/">
            <Icon name="mail" class="" />Contact me
          </a>
          <a
            class="btn btn--ghost"
            href="https://www.toptal.com/developers/resume/roman-bartusiak#Bv9aj2"
            rel="noopener">Toptal profile</a
          >
        </p>
      </div>
      <div class="contact__badge"><ToptalBadge scale={0.62} /></div>
    </div>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 300px);
    gap: clamp(2rem, 6vw, 4.5rem);
    align-items: center;
    padding-block: clamp(2.25rem, 5vw, 3.75rem);
  }
  .hero__role {
    margin: 1rem 0 0;
    font-size: var(--t-root);
    font-weight: 600;
    color: var(--ink);
  }
  .hero__lede {
    margin: 0.9rem 0 0;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin: 1.75rem 0 0;
  }
  .hero__fig {
    margin: 0;
    justify-self: end;
    width: 100%;
    max-width: 300px;
  }
  .hero__fig picture,
  .hero__fig img {
    animation: settle-fig 700ms var(--ease) 80ms backwards;
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-lg);
  }

  .hero__now {
    margin: 1.25rem 0 0;
    max-width: 52ch;
    font-size: var(--t-md);
    color: var(--body);
  }
  .hero__now b {
    font-weight: 650;
    color: var(--ink);
  }
  .hero__cred {
    margin: 0.5rem 0 0;
    max-width: 52ch;
    font-size: var(--t-md);
    line-height: 1.6;
    color: var(--muted);
  }
  .hero__cred b {
    font-weight: 650;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .now {
    cursor: default;
  }
  .more {
    margin: 1.5rem 0 0;
  }
  .more__l {
    font-size: var(--t-md);
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
  }
  .more__l:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .now__role {
    margin: 0;
    font-size: var(--t-root);
    font-weight: 650;
    letter-spacing: -0.018em;
    line-height: 1.3;
    color: var(--ink);
  }
  .now__org {
    margin: 0.35rem 0 0;
    font-size: var(--t-base);
    color: var(--body);
  }
  .now__where {
    color: var(--muted);
  }

  .rows--tight .row__d {
    margin: 0;
  }
  .row__auth {
    margin: 0.3rem 0 0;
    font-size: var(--t-sm);
    color: var(--muted);
  }
  .rows--tight .row__link--tight {
    grid-template-columns: 11rem minmax(0, 1fr);
    padding-block: 1rem;
    align-items: baseline;
  }
  .row__link--plain {
    cursor: default;
  }
  .row__link--plain:hover {
    background: transparent;
  }
  .row__link--plain .row__date {
    color: var(--muted) !important;
  }
  .rows--tight .row__date {
    color: var(--accent);
    font-weight: 600;
  }

  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(2rem, 6vw, 4rem);
    align-items: center;
  }
  .contact__h {
    margin: 0;
    font-size: var(--d-sm);
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .contact__p {
    margin: 0.9rem 0 0;
  }
  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin: 1.6rem 0 0;
  }
  .contact__badge {
    display: grid;
    place-items: center;
  }

  @media (max-width: 820px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }
    .hero__fig {
      order: -1;
      justify-self: start;
      max-width: 160px;
    }
    .contact {
      grid-template-columns: minmax(0, 1fr);
    }
    .contact__badge {
      justify-items: start;
      margin-left: -0.5rem;
    }
    .rows--tight .row__link--tight {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.25rem;
    }
  }
</style>
