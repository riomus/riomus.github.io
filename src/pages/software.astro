---
import Page from '../layouts/Page.astro';
import Icon from '../components/Icon.astro';
import { software } from '../data/record';
---

<Page
  title="Software"
  description="Projects and open-source libraries by Roman Bartusiak: BORSUK, SFORA, SparklingGraph, polish-sentiment, vibe.js, OpticalFlow.js, HMM.js and Data Projector."
  lede="Libraries and systems I wrote and still stand behind — object-storage vector retrieval, deep metric learning, distributed graph processing, Polish-language sentiment, and a handful of computer-vision and sequence algorithms ported to JavaScript. Two are still being built, and say so."
  datum={`${software.length} projects`}
>
  <ul class="rows" data-stagger>
    {
      software.map((s) => (
        <li class="row">
          {s.href ? (
            <a class="row__link sw" href={s.href} rel="noopener">
              <span class="sw__name">
                {s.name}
                <Icon name="ext" class="icon--ghost" />
              </span>
              <div>
                {s.wip && <p class="sw__wip"><span class="tag">Under construction</span></p>}
                <p class="row__d" style="margin:0">
                  {s.note}
                </p>
                {s.years && <p class="sw__years mono">{s.years}</p>}
              </div>
            </a>
          ) : (
            <div class="row__link sw sw--plain">
              <span class="sw__name">{s.name}</span>
              <div>
                <p class="row__d" style="margin:0">
                  {s.note}
                </p>
                <p class="sw__years mono">
                  {s.years}
                  {s.years && ' · '}No public mirror
                </p>
              </div>
            </div>
          )}
        </li>
      ))
    }
  </ul>
</Page>

<style>
  .sw {
    grid-template-columns: 12rem minmax(0, 1fr);
    align-items: baseline;
  }
  .sw--plain {
    cursor: default;
  }
  .sw__name {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: 'Chivo Mono', monospace;
    font-size: var(--t-base);
    font-weight: 600;
    color: var(--accent);
  }
  .sw--plain .sw__name {
    color: var(--muted);
  }
  /* Above the description, not after it: the status has to land before the
     reader has decided what the thing is. */
  .sw__wip {
    margin: 0 0 0.4rem;
  }
  .sw__years {
    margin: 0.4rem 0 0;
    font-size: var(--t-sm);
    color: var(--muted);
  }
  @media (max-width: 700px) {
    .sw {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.35rem;
    }
  }
</style>
