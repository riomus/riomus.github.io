---
import { getCollection } from 'astro:content';
import Page from '../../layouts/Page.astro';
import PostRow from '../../components/PostRow.astro';
import { tagSlug } from '../../utils';

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
  );
  // Group by slug, not spelling: "NVIDIA" and "Nvidia" are one topic and must
  // not race for the same route.
  const bySlug = new Map<string, { tag: string; posts: typeof posts }>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      const slug = tagSlug(tag);
      const entry = bySlug.get(slug) ?? { tag, posts: [] };
      if (!entry.posts.includes(post)) entry.posts.push(post);
      bySlug.set(slug, entry);
    }
  }
  const total = posts.length;
  return [...bySlug].map(([tag, v]) => ({ params: { tag }, props: { ...v, total } }));
}

const { tag, posts, total } = Astro.props;

const all = await getCollection('posts');
const counts = new Map<string, { tag: string; n: number }>();
for (const p of all)
  for (const t of p.data.tags) {
    const k = tagSlug(t);
    const e = counts.get(k) ?? { tag: t, n: 0 };
    e.n += 1;
    counts.set(k, e);
  }
const topics = [...counts.values()].sort((a, b) => b.n - a.n || a.tag.localeCompare(b.tag));
const here = tagSlug(tag);
---

<Page
  title={tag}
  description={`Posts on bartusiak.ai tagged ${tag}.`}
  datum={`${posts.length} of ${total} posts`}
>
  <nav class="filter" aria-label="Topics">
    <a class="fchip" href="/writing/">All<span class="fchip__n">{total}</span></a>
    {
      topics.map((t) => (
        <a
          class="fchip"
          href={`/tags/${tagSlug(t.tag)}/`}
          aria-current={tagSlug(t.tag) === here ? 'page' : undefined}
        >
          {t.tag}
          <span class="fchip__n">{t.n}</span>
        </a>
      ))
    }
  </nav>

  <ul class="rows" data-stagger>
    {posts.map((p) => <PostRow post={p} level={2} />)}
  </ul>

</Page>

<style>
  .filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 2rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--line);
  }
  .fchip {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 99px;
    background: var(--bg);
    color: var(--body);
    font-size: var(--t-base);
    text-decoration: none;
    transition: border-color 140ms var(--ease), color 140ms var(--ease);
  }
  .fchip:hover {
    border-color: var(--line-strong);
    color: var(--ink);
  }
  .fchip__n {
    font-size: var(--t-xs);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .fchip[aria-current='page'] {
    background: var(--brand);
    border-color: var(--brand);
    color: var(--ink);
    font-weight: 600;
  }
  .fchip[aria-current='page'] .fchip__n {
    color: var(--ink);
    font-weight: 500;
  }
</style>
